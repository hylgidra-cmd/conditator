    "check": "npm run typecheck && npm run lint && npm run check:i18n && npm run format:check"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans": "5.3.0",
    "@prisma/client": "6.19.3",
    "next": "15.5.28",
    "next-intl": "4.14.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3",
    "@tailwindcss/postcss": "4",
    "@types/node": "20",
    "@types/react": "19",
    "@types/react-dom": "19",
    "eslint": "9",
    "eslint-config-next": "15.5.28",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prisma": "6.19.3",
    "tailwindcss": "4",
    "typescript": "5"
  }
