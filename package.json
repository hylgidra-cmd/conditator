{
  "name": "jumis-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "node scripts/vercel-build.mjs",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check:i18n": "node scripts/check-messages.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "postinstall": "prisma generate",
    "check": "npm run typecheck && npm run lint && npm run check:i18n && npm run format:check",
    "db:seed": "prisma db seed",
    "db:deploy": "prisma migrate deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "load:seed": "tsx scripts/load/seed.ts",
    "load:run": "node scripts/load/run.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@fontsource-variable/inter": "5.2.8",
    "@fontsource-variable/noto-sans": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@node-rs/argon2": "2.2.2",
    "@prisma/client": "6.19.3",
    "next": "15.5.28",
    "next-intl": "4.14.9",
    "nodemailer": "10.2.1",
    "playwright-core": "^1.63.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3",
    "@tailwindcss/postcss": "4",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19",
    "@types/react-dom": "19",
    "eslint": "9",
    "eslint-config-next": "15.5.28",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prisma": "6.19.3",
    "tailwindcss": "4",
    "tsx": "4.23.15",
    "typescript": "5",
    "vitest": "5.0.5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
