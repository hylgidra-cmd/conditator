# Production sozlamalari. Serverda nusxa oling: cp .env.production.example .env.production
# .env.production hech qachon gitga tushmaydi (.gitignore). CHANGE_ME qolgan qator bo'lsa,
# deploy/deploy.sh ishga tushmaydi.

# --- Domen va HTTPS (Caddy, Let's Encrypt) ---
# DNS: DOMAIN va www.DOMAIN ning A yozuvi server IP siga qaragan bo'lishi kerak.
DOMAIN=CHANGE_ME.uz
# Let's Encrypt sertifikat muddati haqida xabar shu emailga keladi.
ACME_EMAIL=CHANGE_ME@example.com
APP_URL=https://CHANGE_ME.uz

# --- Xavfsizlik ---
# Yarating: openssl rand -hex 32
AUTH_SECRET=CHANGE_ME

# --- Ma'lumotlar bazasi (postgres konteyneri, tashqariga ochilmaydi) ---
POSTGRES_USER=jumis
# Yarating: openssl rand -hex 24  (faqat harf va raqam: URL ichida ishlatiladi)
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=jumis

# --- Email (haqiqiy SMTP). 465 = SSL, 587 = STARTTLS ---
SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Jumis AI <no-reply@CHANGE_ME.uz>"

# --- AI ---
AI_PROVIDER=anthropic
# Bo'sh bo'lsa sayt ishlaydi, AI o'rniga kalit so'z qidiruvi ishlaydi.
ANTHROPIC_API_KEY=
AI_MODEL_CV=claude-haiku-5-5
AI_MODEL_MATCH=claude-sonnet-5-5
# Faqat birinchi ishga tushirishda yoziladi; keyin admin panelda o'zgartiriladi.
AI_MONTHLY_LIMIT_USD=50

# --- Birinchi admin (seed). Parol ≥ 12 belgi. Admin yaratilgach parolni shu fayldan o'chiring. ---
ADMIN_EMAIL=CHANGE_ME@example.com
ADMIN_PASSWORD=

# --- Zaxira nusxa ---
# Serverdagi papka (docker-compose.prod.yml joylashgan papkaga nisbatan yoki to'liq yo'l).
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14

# PDF: bo'sh qoldiring (Docker obrazidagi Chromium ishlatiladi).
CHROMIUM_PATH=
