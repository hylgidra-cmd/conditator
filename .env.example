# Nusxa oling: cp .env.example .env  — .env hech qachon gitga tushmaydi.

# --- Ilova ---
APP_URL=http://localhost:3000

# --- Ma'lumotlar bazasi ---
POSTGRES_USER=jumis
POSTGRES_PASSWORD=jumis
POSTGRES_DB=jumis
# Docker ichida compose o'zi db hostini qo'yadi. Bu qator kompyuterda `npm run dev` uchun:
DATABASE_URL=postgresql://jumis:jumis@localhost:5432/jumis?schema=public

# --- Email (dev: Mailpit, prod: haqiqiy SMTP) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Jumis AI <no-reply@jumis.local>"

# --- AI (1.5-qadamdan) ---
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL_CV=claude-haiku-5-5
AI_MODEL_MATCH=claude-sonnet-5-5
AI_MONTHLY_LIMIT_USD=50

# --- Admin (seed, 1.3-qadamdan) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
