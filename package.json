{
  "name": "jumis-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check:i18n": "node scripts/check-messages.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
