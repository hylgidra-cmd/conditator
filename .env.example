# Nusxa oling: cp .env.example .env  — .env hech qachon gitga tushmaydi.

# --- Ilova ---
APP_URL=http://localhost:3000
# Sessiya va email kodlari xeshi uchun sir (kamida 32 belgi).
# Serverda albatta almashtiring: openssl rand -hex 32  ("dev-only" bilan boshlangan qiymat HTTPS da ishlamaydi)
AUTH_SECRET=dev-only-change-me-0123456789abcdef0123456789

# --- Ma'lumotlar bazasi ---
# Testlar alohida bazada: TEST_DATABASE_URL (standart: .../jumis_test)
POSTGRES_USER=jumis
POSTGRES_PASSWORD=jumis
POSTGRES_DB=jumis
# Docker ichida compose o'zi db hostini qo'yadi. Bu qator kompyuterda `npm run dev` uchun:
DATABASE_URL=postgresql://jumis:jumis@localhost:5432/jumis?schema=public

# --- Email (faqat parol tiklash uchun; bo'sh bo'lsa login/register baribir ishlaydi) ---
# Vercel: Resend (https://resend.com) API kaliti. EMAIL_FROM Resend da tasdiqlangan domendan bo'lsin.
RESEND_API_KEY=
EMAIL_FROM="Jumis AI <no-reply@jumis.local>"
# Yoki SMTP (Docker/VPS). RESEND_API_KEY bo'lsa SMTP ishlatilmaydi.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# --- AI (1.5-qadamdan) ---
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL_CV=claude-haiku-5-5
AI_MODEL_MATCH=claude-sonnet-5-5
AI_MONTHLY_LIMIT_USD=50

# --- Admin (seed, 1.3-qadamdan) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# PDF: Chromium yo'li (ixtiyoriy). Bo'sh bo'lsa, Playwright o'rnatgan Chromium ishlatiladi.
CHROMIUM_PATH=

# Yuklangan fayllar (kompaniya logolari) papkasi. Docker da: /app/data/uploads (volume).
UPLOAD_DIR=data/uploads
