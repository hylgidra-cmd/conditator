// Jumis AI (Candidator) ma'lumotlar bazasi sxemasi.
// Tavsif va aloqalar: docs/DB-SCHEMA.md. Reja: docs/PLAN.md, 2-bo'lim.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enumlar ----------

enum Role {
  STUDENT
  COMPANY
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

/// Interfeys va CV tillari. kk = qoraqalpoq (loyiha kelishuvi).
enum Lang {
  kk
  uz
  ru
  en
}

enum EmailCodePurpose {
  VERIFY
  RESET
}

enum Approval {
  PENDING
  APPROVED
  REJECTED
}

enum WorkType {
  FULL_TIME
  PART_TIME
  REMOTE
  INTERNSHIP
}

enum MatchDecision {
  NONE
  SELECTED
  REJECTED
}

enum AiTask {
  CV_GEN
  MATCH
}

enum VacancyStatus {
  ACTIVE
  CLOSED
  CANCELLED
}

enum ApplicationStatus {
  SUBMITTED
  VIEWED
  INTERESTED
  ACCEPTED
  REJECTED
}

enum CandidateStageType {
  NEW
  REVIEWING
  LIKED
  INTERVIEW
  ACCEPTED
  REJECTED
}

enum CompanyRole {
  OWNER
  MANAGER
  OBSERVER
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED
  BLOCKED
}

enum ComplaintStatus {
  PENDING
  INVESTIGATING
  RESOLVED
  DISMISSED
}

enum PaymentPurpose {
  CV_CREATION
  VACANCY_UNLOCK
  WEEKLY_APPLY_PASS
}

enum PaymentProvider {
  CLICK
  PAYME
  TEST
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

// ---------- Foydalanuvchilar va kirish ----------

model User {
  id              String     @id @default(cuid())
  email           String     @unique /// har doim kichik harflarda saqlanadi
  passwordHash    String /// argon2id
  role            Role
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  locale          Lang       @default(kk)
  consentAt       DateTime? /// shaxsiy ma'lumotlarni qayta ishlashga rozilik
  applyPassUntil  DateTime? /// haftalik CV topshirish ruxsati tugash vaqti
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  sessions           Session[]
  emailCodes         EmailCode[]
  cvs                Cv[]
  company            Company?
  aiLogs             AiLog[]
  adminLogs          AdminLog[]
  applications       VacancyApplication[]
  companyMembers     CompanyMember[]
  sentMessages       ChatMessage[]
  payments           Payment[]
  notifications      Notification[]
  filedComplaints    Complaint[]          @relation("Reporter")
  reportedComplaints Complaint[]          @relation("ReportedUser")
  supportThread      SupportThread?
  supportMessages    SupportMessage[]

  @@index([role, status])
}

/// Bazadagi sessiya: cookie da tasodifiy token, bazada faqat uning xeshi.
/// Bloklanganda yoki parol tiklanganda foydalanuvchining sessiyalari o'chiriladi.
model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Email tasdiqlash va parol tiklash kodlari. Kodning o'zi hech qachon saqlanmaydi.
model EmailCode {
  id        String           @id @default(cuid())
  userId    String
  purpose   EmailCodePurpose
  codeHash  String
  expiresAt DateTime
  attempts  Int              @default(0)
  usedAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

// ---------- Talaba & CV ----------

model Cv {
  id            String     @id @default(cuid()) /// AI ga anonim ID sifatida shu yuboriladi
  userId        String
  title         String     @default("Mening rezyumem")
  templateId    String     @default("modern")
  privacy       Json       @default("{\"hideName\":false,\"hidePhone\":false,\"hideEmail\":false,\"hideAddress\":false,\"hidePhoto\":false}")
  isPaid        Boolean    @default(true)
  language      Lang       @default(en)
  sourceText    String? /// talabaning erkin matni (≤ 3000 belgi)
  /// CV maydonlari: ism, aloqa, maqsad, ta'lim, tajriba, ko'nikmalar, tillar, sertifikatlar.
  /// Tuzilmasi zod sxemasi bilan belgilanadi (src/backend/cv).
  data          Json       @default("{}")
  missingFields String[] /// AI to'ldira olmagan maydonlar ("to'ldiring" belgisi)
  isVisible     Boolean    @default(false)
  savedAt       DateTime? /// null = hech saqlanmagan, kompaniyaga ko'rinmaydi. CV versiyasi ham shu.
  // Filtr maydonlari (data dan saqlashda to'ldiriladi)
  skills        String[]
  languages     String[]
  location      String?
  workTypes     WorkType[]
  searchText    String     @default("") /// kalit so'z qidiruvi uchun (kichik harflarda, aloqa ma'lumotisiz)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  matches      Match[]
  views        CvView[]
  applications VacancyApplication[]
  likes        CandidateLike[]
  stages       CandidateStage[]
  payments     Payment[]

  @@index([userId])
  @@index([isVisible, language])
  @@index([skills], type: Gin)
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "Cv_searchText_trgm_idx")
}

// ---------- Kompaniya ----------

model Company {
  id                String    @id @default(cuid())
  userId            String    @unique
  name              String?
  country           String?
  industry          String?
  size              String? /// xodimlar soni oralig'i, masalan "11-50"
  contactPerson     String?
  logoPath          String?
  approval          Approval  @default(PENDING)
  approvedAt        DateTime?
  subscriptionUntil DateTime? /// obuna faol = subscriptionUntil > hozir
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  vacancies     Vacancy[]
  cvViews       CvView[]
  members       CompanyMember[]
  likes         CandidateLike[]
  stages        CandidateStage[]
  unlocks       VacancyUnlock[]
  conversations Conversation[]
  payments      Payment[]

  @@index([approval])
}

/// Kompaniya CV ni (ism va aloqa bilan) ochgan har bir holat. Ommaviy yig'ishni kuzatish uchun.
model CvView {
  id        String   @id @default(cuid())
  cvId      String
  companyId String
  pdf       Boolean  @default(false) /// true = PDF yuklab olingan
  createdAt DateTime @default(now())

  cv      Cv      @relation(fields: [cvId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([cvId])
}

model Vacancy {
  id                 String        @id @default(cuid())
  companyId          String
  title              String
  rawText            String? /// erkin matnli talab (istalgan tilda)
  skills             String[]
  languages          String[]
  minExperienceYears Int?
  location           String?
  workType           WorkType?
  salaryFrom         Int?
  salaryTo           Int?
  currency           String        @default("UZS")
  education          String?
  status             VacancyStatus @default(ACTIVE)
  closeReason        String?
  expiresAt          DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  company      Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  matches      Match[]
  applications VacancyApplication[]
  stages       CandidateStage[]
  unlocks      VacancyUnlock[]
  conversations Conversation[]

  @@index([companyId, createdAt])
  @@index([status])
}

/// Saralash natijasi. hash = xesh(talab + CV versiyasi): o'zgarmagan bo'lsa AI qayta chaqirilmaydi.
model Match {
  id        String        @id @default(cuid())
  vacancyId String
  cvId      String
  score     Int /// 0–100
  reason    String /// 1–2 gaplik izoh
  hash      String
  decision  MatchDecision @default(NONE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  vacancy Vacancy @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  cv      Cv      @relation(fields: [cvId], references: [id], onDelete: Cascade)

  @@unique([vacancyId, cvId])
  @@index([vacancyId, score])
  @@index([cvId, decision])
}

// ---------- Arizalar, Bosqichlar, Yoqdi va Jamoa ----------

model VacancyApplication {
  id        String            @id @default(cuid())
  vacancyId String
  cvId      String
  studentId String
  status    ApplicationStatus @default(SUBMITTED)
  note      String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  vacancy Vacancy @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  cv      Cv      @relation(fields: [cvId], references: [id], onDelete: Cascade)
  student User    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([vacancyId, cvId])
  @@index([vacancyId, status])
  @@index([studentId])
}

model CandidateLike {
  id        String   @id @default(cuid())
  companyId String
  cvId      String
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cv      Cv      @relation(fields: [cvId], references: [id], onDelete: Cascade)

  @@unique([companyId, cvId])
  @@index([cvId])
}

model CandidateStage {
  id        String             @id @default(cuid())
  vacancyId String
  cvId      String
  companyId String
  stage     CandidateStageType @default(NEW)
  note      String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  vacancy Vacancy @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  cv      Cv      @relation(fields: [cvId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([vacancyId, cvId])
  @@index([companyId, stage])
}

model CompanyMember {
  id        String      @id @default(cuid())
  companyId String
  userId    String
  role      CompanyRole @default(MANAGER)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([userId])
}

// ---------- Chat va Shikoyatlar ----------

model Conversation {
  id          String             @id @default(cuid())
  vacancyId   String?
  companyId   String
  studentId   String
  studentCvId String?
  status      ConversationStatus @default(ACTIVE)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  company    Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vacancy    Vacancy?      @relation(fields: [vacancyId], references: [id], onDelete: SetNull)
  messages   ChatMessage[]
  complaints Complaint[]

  @@unique([companyId, studentId, vacancyId])
  @@index([companyId, updatedAt])
  @@index([studentId, updatedAt])
}

model ChatMessage {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  senderRole     Role
  text           String
  fileUrl        String?
  fileName       String?
  fileSize       Int?
  isSystem       Boolean   @default(false)
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Complaint {
  id             String          @id @default(cuid())
  reporterId     String
  reportedUserId String
  conversationId String?
  reason         String
  details        String?
  status         ComplaintStatus @default(PENDING)
  resolvedAt     DateTime?
  resolvedById   String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  reporter     User          @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser User          @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

// ---------- Monetizatsiya & To'lovlar ----------

model Payment {
  id                 String          @id @default(cuid())
  userId             String
  companyId          String?
  vacancyId          String?
  cvId               String?
  amount             Int
  purpose            PaymentPurpose
  provider           PaymentProvider
  status             PaymentStatus   @default(PENDING)
  externalId         String?
  transactionDetails Json            @default("{}")
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  cv      Cv?      @relation(fields: [cvId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([externalId])
}

model VacancyUnlock {
  id        String   @id @default(cuid())
  vacancyId String
  companyId String
  paymentId String?
  paidAt    DateTime @default(now())
  expiresAt DateTime
  createdAt DateTime @default(now())

  vacancy Vacancy @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([vacancyId, companyId])
  @@index([expiresAt])
}

// ---------- Bildirishnomalar ----------

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

// ---------- AI va sozlamalar ----------

/// Har bir AI so'rovi (har bir urinish) shu yerga yoziladi.
model AiLog {
  id           String   @id @default(cuid())
  task         AiTask
  provider     String
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  costUsd      Decimal  @default(0) @db.Decimal(10, 6)
  durationMs   Int      @default(0)
  ok           Boolean
  errorCode    String?
  userId       String?
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

enum AdminAction {
  USER_BLOCK
  USER_UNBLOCK
  COMPANY_APPROVE
  COMPANY_REJECT
  SUBSCRIPTION_SET
  SUBSCRIPTION_OFF
  AI_LIMIT_SET
  RESOLVE_COMPLAINT
}

/// Admin harakatlari jurnali. Admin o'chirilsa ham yozuv qoladi (adminId bo'shatiladi).
model AdminLog {
  id         String      @id @default(cuid())
  adminId    String?
  action     AdminAction
  targetType String /// "User", "Company", "Setting", "Complaint"
  targetId   String
  /// Qisqa tafsilot: oldingi va yangi qiymat, nishon email/nomi (keyin o'chirilsa ham tushunarli bo'lsin).
  details    Json        @default("{}")
  createdAt  DateTime    @default(now())

  admin User? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([targetType, targetId])
}

/// Kalit-qiymat sozlamalar, masalan monthlyAiLimitUsd, cvCreationPriceUzs, candidateUnlockPriceUzs.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ---------- Qo'llab-quvvatlash xizmati (Admin bilan chat) ----------

model SupportThread {
  id        String           @id @default(cuid())
  userId    String           @unique
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages SupportMessage[]

  @@index([updatedAt])
}

model SupportMessage {
  id         String    @id @default(cuid())
  threadId   String
  senderId   String
  senderRole Role
  text       String
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  thread SupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User          @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}
