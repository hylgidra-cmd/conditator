# HTTPS: Caddy sertifikatni Let's Encrypt dan o'zi oladi va yangilaydi (80 va 443 ochiq bo'lishi kerak).
{
	email {$ACME_EMAIL}
}

# www → asosiy domen
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	# Siqish shu yerda (Next.js da o'chirilgan: compress: false).
	encode zstd gzip

	# Eng katta so'rov: logo (1 MB). Ilova ham o'zi tekshiradi (readBodyLimited).
	request_body {
		max_size 2MB
	}

	# Caddy mijoz yuborgan X-Forwarded-For ni qabul qilmaydi va haqiqiy IP ni o'zi qo'yadi
	# (ilova oxirgi qiymatni oladi: src/lib/http/request.ts).
	reverse_proxy app:3000 {
		header_up X-Forwarded-For {remote_host}
	}

	header {
		-Server
	}

	log {
		output stdout
		format json
	}
}
